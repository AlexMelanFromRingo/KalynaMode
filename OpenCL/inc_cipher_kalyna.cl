/* Branchless GF(2^8) doubling, reduction polynomial 0x11d. */
#define KAL_M2(x) ((u8) (((u32)(x) << 1) ^ (((u32) 0u - ((u32)(x) >> 7)) & 0x1du)))

DECLSPEC u64 kalyna_sub_bytes_word (const u64 v)
{
  return ((u64) c_kalyna_enc_sbox[0][(u32) (v >>  0) & 0xff])       |
         ((u64) c_kalyna_enc_sbox[1][(u32) (v >>  8) & 0xff] <<  8) |
         ((u64) c_kalyna_enc_sbox[2][(u32) (v >> 16) & 0xff] << 16) |
         ((u64) c_kalyna_enc_sbox[3][(u32) (v >> 24) & 0xff] << 24) |
         ((u64) c_kalyna_enc_sbox[0][(u32) (v >> 32) & 0xff] << 32) |
         ((u64) c_kalyna_enc_sbox[1][(u32) (v >> 40) & 0xff] << 40) |
         ((u64) c_kalyna_enc_sbox[2][(u32) (v >> 48) & 0xff] << 48) |
         ((u64) c_kalyna_enc_sbox[3][(u32) (v >> 56) & 0xff] << 56);
}

/* Multiply one 8-byte column by the constant Kalyna MDS matrix in GF(2^8). */
DECLSPEC u64 kalyna_mix_one_column (const u64 v)
{
  const u8 b0 = (u8) (v >>  0);
  const u8 b1 = (u8) (v >>  8);
  const u8 b2 = (u8) (v >> 16);
  const u8 b3 = (u8) (v >> 24);
  const u8 b4 = (u8) (v >> 32);
  const u8 b5 = (u8) (v >> 40);
  const u8 b6 = (u8) (v >> 48);
  const u8 b7 = (u8) (v >> 56);

  const u8 b0_2 = KAL_M2 (b0);  const u8 b0_4 = KAL_M2 (b0_2);  const u8 b0_8 = KAL_M2 (b0_4);
  const u8 b1_2 = KAL_M2 (b1);  const u8 b1_4 = KAL_M2 (b1_2);  const u8 b1_8 = KAL_M2 (b1_4);
  const u8 b2_2 = KAL_M2 (b2);  const u8 b2_4 = KAL_M2 (b2_2);  const u8 b2_8 = KAL_M2 (b2_4);
  const u8 b3_2 = KAL_M2 (b3);  const u8 b3_4 = KAL_M2 (b3_2);  const u8 b3_8 = KAL_M2 (b3_4);
  const u8 b4_2 = KAL_M2 (b4);  const u8 b4_4 = KAL_M2 (b4_2);  const u8 b4_8 = KAL_M2 (b4_4);
  const u8 b5_2 = KAL_M2 (b5);  const u8 b5_4 = KAL_M2 (b5_2);  const u8 b5_8 = KAL_M2 (b5_4);
  const u8 b6_2 = KAL_M2 (b6);  const u8 b6_4 = KAL_M2 (b6_2);  const u8 b6_8 = KAL_M2 (b6_4);
  const u8 b7_2 = KAL_M2 (b7);  const u8 b7_4 = KAL_M2 (b7_2);  const u8 b7_8 = KAL_M2 (b7_4);

  #define KM5(B) ((u8) (B##_4 ^ B))
  #define KM6(B) ((u8) (B##_4 ^ B##_2))
  #define KM7(B) ((u8) (B##_4 ^ B##_2 ^ B))

  const u8 o0 = (u8)(b0      ^ b1      ^ KM5(b2) ^ b3      ^ b4_8    ^ KM6(b5) ^ KM7(b6) ^ b7_4);
  const u8 o1 = (u8)(b0_4    ^ b1      ^ b2      ^ KM5(b3) ^ b4      ^ b5_8    ^ KM6(b6) ^ KM7(b7));
  const u8 o2 = (u8)(KM7(b0) ^ b1_4    ^ b2      ^ b3      ^ KM5(b4) ^ b5      ^ b6_8    ^ KM6(b7));
  const u8 o3 = (u8)(KM6(b0) ^ KM7(b1) ^ b2_4    ^ b3      ^ b4      ^ KM5(b5) ^ b6      ^ b7_8);
  const u8 o4 = (u8)(b0_8    ^ KM6(b1) ^ KM7(b2) ^ b3_4    ^ b4      ^ b5      ^ KM5(b6) ^ b7);
  const u8 o5 = (u8)(b0      ^ b1_8    ^ KM6(b2) ^ KM7(b3) ^ b4_4    ^ b5      ^ b6      ^ KM5(b7));
  const u8 o6 = (u8)(KM5(b0) ^ b1      ^ b2_8    ^ KM6(b3) ^ KM7(b4) ^ b5_4    ^ b6      ^ b7);
  const u8 o7 = (u8)(b0      ^ KM5(b1) ^ b2      ^ b3_8    ^ KM6(b4) ^ KM7(b5) ^ b6_4    ^ b7);

  #undef KM5
  #undef KM6
  #undef KM7

  return ((u64)o0)        | ((u64)o1 <<  8) | ((u64)o2 << 16) | ((u64)o3 << 24)
       | ((u64)o4 << 32)  | ((u64)o5 << 40) | ((u64)o6 << 48) | ((u64)o7 << 56);
}

/*
 * ShiftRows over an NB-word state.
 *
 * Spec: each row r is shifted left by floor(r * NB / 8) columns. Bytes are
 * laid out so byte b of column c lives in (state[c] >> (b * 8)) & 0xff.
 *
 * For nb = 2 this is just a swap of the upper 32 bits of the two columns,
 * so we keep a fast path that avoids byte arrays entirely (some OpenCL
 * runtimes — notably PoCL — produce flaky code for the generic byte path).
 * For nb = 4 / 8 the generic byte-shuffle path is used.
 */
DECLSPEC void kalyna_shift_rows (PRIVATE_AS u64 *state)
{
#if KALYNA_NB == 2
  const u64 lo0 = state[0] & 0x00000000ffffffffUL;
  const u64 hi0 = state[0] & 0xffffffff00000000UL;
  const u64 lo1 = state[1] & 0x00000000ffffffffUL;
  const u64 hi1 = state[1] & 0xffffffff00000000UL;
  state[0] = lo0 | hi1;
  state[1] = lo1 | hi0;
#else
  u8 cols[KALYNA_NB][8];
  u8 out[KALYNA_NB][8];

  for (int c = 0; c < KALYNA_NB; ++c)
  {
    const u64 v = state[c];
    cols[c][0] = (u8)(v >>  0); cols[c][1] = (u8)(v >>  8);
    cols[c][2] = (u8)(v >> 16); cols[c][3] = (u8)(v >> 24);
    cols[c][4] = (u8)(v >> 32); cols[c][5] = (u8)(v >> 40);
    cols[c][6] = (u8)(v >> 48); cols[c][7] = (u8)(v >> 56);
  }

  for (int r = 0; r < 8; ++r)
  {
    const int shift = (r * KALYNA_NB) / 8;
    for (int c = 0; c < KALYNA_NB; ++c)
    {
      const int newc = (c + shift) % KALYNA_NB;
      out[newc][r] = cols[c][r];
    }
  }

  for (int c = 0; c < KALYNA_NB; ++c)
  {
    state[c] = ((u64) out[c][0])       | ((u64) out[c][1] <<  8)
             | ((u64) out[c][2] << 16) | ((u64) out[c][3] << 24)
             | ((u64) out[c][4] << 32) | ((u64) out[c][5] << 40)
             | ((u64) out[c][6] << 48) | ((u64) out[c][7] << 56);
  }
#endif
}

DECLSPEC void kalyna_sub_bytes (PRIVATE_AS u64 *state)
{
  for (int i = 0; i < KALYNA_NB; ++i) state[i] = kalyna_sub_bytes_word (state[i]);
}

DECLSPEC void kalyna_mix_columns (PRIVATE_AS u64 *state)
{
  for (int i = 0; i < KALYNA_NB; ++i) state[i] = kalyna_mix_one_column (state[i]);
}

DECLSPEC void kalyna_encipher_round (PRIVATE_AS u64 *state)
{
  kalyna_sub_bytes (state);
  kalyna_shift_rows (state);
  kalyna_mix_columns (state);
}

DECLSPEC void kalyna_add_words (PRIVATE_AS u64 *dst, PRIVATE_AS const u64 *src)
{
  for (int i = 0; i < KALYNA_NB; ++i) dst[i] += src[i];
}

DECLSPEC void kalyna_xor_words (PRIVATE_AS u64 *dst, PRIVATE_AS const u64 *src)
{
  for (int i = 0; i < KALYNA_NB; ++i) dst[i] ^= src[i];
}

/* Rotate the NB-word state left by (2 * NB + 3) bytes (used by KeyExpandOdd).
 * NB = 2 has a closed-form fast path (rotation by 7 bytes inside 16). */
DECLSPEC void kalyna_rotate_state_left (PRIVATE_AS u64 *state)
{
#if KALYNA_NB == 2
  const u64 a = state[0];
  const u64 b = state[1];
  state[0] = (a >> 56) | (b << 8);
  state[1] = (b >> 56) | (a << 8);
#else
  const int rot = 2 * KALYNA_NB + 3;
  const int total = KALYNA_NB * 8;

  u8 buf[KALYNA_NB * 8];
  for (int c = 0; c < KALYNA_NB; ++c)
  {
    const u64 v = state[c];
    buf[c * 8 + 0] = (u8)(v >>  0); buf[c * 8 + 1] = (u8)(v >>  8);
    buf[c * 8 + 2] = (u8)(v >> 16); buf[c * 8 + 3] = (u8)(v >> 24);
    buf[c * 8 + 4] = (u8)(v >> 32); buf[c * 8 + 5] = (u8)(v >> 40);
    buf[c * 8 + 6] = (u8)(v >> 48); buf[c * 8 + 7] = (u8)(v >> 56);
  }

  u8 tmp[KALYNA_NB * 8];
  for (int i = 0; i < total; ++i) tmp[i] = buf[(i + rot) % total];

  for (int c = 0; c < KALYNA_NB; ++c)
  {
    state[c] = ((u64) tmp[c * 8 + 0])       | ((u64) tmp[c * 8 + 1] <<  8)
             | ((u64) tmp[c * 8 + 2] << 16) | ((u64) tmp[c * 8 + 3] << 24)
             | ((u64) tmp[c * 8 + 4] << 32) | ((u64) tmp[c * 8 + 5] << 40)
             | ((u64) tmp[c * 8 + 6] << 48) | ((u64) tmp[c * 8 + 7] << 56);
  }
#endif
}

/* Rotate K-word vector left by 1 word (used by KeyExpandEven). */
DECLSPEC void kalyna_rotate_words_left (PRIVATE_AS u64 *v)
{
  u64 t = v[0];
  for (int i = 1; i < KALYNA_NK; ++i) v[i - 1] = v[i];
  v[KALYNA_NK - 1] = t;
}

/*
 * Compute the auxiliary kt value (3 enciphering rounds with the key).
 * `key_words` holds NK u64 words.
 */
DECLSPEC void kalyna_key_expand_kt (PRIVATE_AS const u64 *key_words,
                                    PRIVATE_AS u64 *kt)
{
  u64 state[KALYNA_NB];
  for (int i = 0; i < KALYNA_NB; ++i) state[i] = 0;
  state[0] += (u64) (KALYNA_NB + KALYNA_NK + 1);

  u64 k0[KALYNA_NB], k1[KALYNA_NB];
#if KALYNA_NK == KALYNA_NB
  for (int i = 0; i < KALYNA_NB; ++i) { k0[i] = key_words[i]; k1[i] = key_words[i]; }
#else
  for (int i = 0; i < KALYNA_NB; ++i) { k0[i] = key_words[i]; k1[i] = key_words[KALYNA_NB + i]; }
#endif

  kalyna_add_words (state, k0);
  kalyna_encipher_round (state);
  kalyna_xor_words (state, k1);
  kalyna_encipher_round (state);
  kalyna_add_words (state, k0);
  kalyna_encipher_round (state);

  for (int i = 0; i < KALYNA_NB; ++i) kt[i] = state[i];
}

/* Schedule even-indexed round keys. */
DECLSPEC void kalyna_key_expand_even (PRIVATE_AS const u64 *key_words,
                                      PRIVATE_AS const u64 *kt,
                                      PRIVATE_AS u64 *rks)
{
  u64 initial_data[KALYNA_NK];
  for (int i = 0; i < KALYNA_NK; ++i) initial_data[i] = key_words[i];

  u64 tmv[KALYNA_NB];
  for (int i = 0; i < KALYNA_NB; ++i) tmv[i] = 0x0001000100010001UL;

  int round = 0;
  for (;;)
  {
    u64 kt_round[KALYNA_NB];
    for (int i = 0; i < KALYNA_NB; ++i) kt_round[i] = kt[i] + tmv[i];

    u64 state[KALYNA_NB];
    for (int i = 0; i < KALYNA_NB; ++i) state[i] = initial_data[i] + kt_round[i];
    kalyna_encipher_round (state);
    kalyna_xor_words (state, kt_round);
    kalyna_encipher_round (state);
    kalyna_add_words (state, kt_round);

    for (int i = 0; i < KALYNA_NB; ++i) rks[round * KALYNA_NB + i] = state[i];

    if (round == KALYNA_NR) break;

#if KALYNA_NK != KALYNA_NB
    round += 2;
    for (int i = 0; i < KALYNA_NB; ++i) tmv[i] <<= 1;

    for (int i = 0; i < KALYNA_NB; ++i) kt_round[i] = kt[i] + tmv[i];

    for (int i = 0; i < KALYNA_NB; ++i) state[i] = initial_data[KALYNA_NB + i] + kt_round[i];
    kalyna_encipher_round (state);
    kalyna_xor_words (state, kt_round);
    kalyna_encipher_round (state);
    kalyna_add_words (state, kt_round);

    for (int i = 0; i < KALYNA_NB; ++i) rks[round * KALYNA_NB + i] = state[i];

    if (round == KALYNA_NR) break;
#endif

    round += 2;
    for (int i = 0; i < KALYNA_NB; ++i) tmv[i] <<= 1;
    kalyna_rotate_words_left (initial_data);
  }
}

/* Fill odd-indexed round keys by rotating the previous even one. */
DECLSPEC void kalyna_key_expand_odd (PRIVATE_AS u64 *rks)
{
  for (int i = 1; i < KALYNA_NR; i += 2)
  {
    u64 tmp[KALYNA_NB];
    for (int j = 0; j < KALYNA_NB; ++j) tmp[j] = rks[(i - 1) * KALYNA_NB + j];
    kalyna_rotate_state_left (tmp);
    for (int j = 0; j < KALYNA_NB; ++j) rks[i * KALYNA_NB + j] = tmp[j];
  }
}

DECLSPEC void kalyna_set_key (PRIVATE_AS u64 *rks, PRIVATE_AS const u32 *key)
{
  u64 key_words[KALYNA_NK];
  for (int i = 0; i < KALYNA_NK; ++i)
  {
    key_words[i] = ((u64) key[i * 2]) | (((u64) key[i * 2 + 1]) << 32);
  }

  u64 kt[KALYNA_NB];
  kalyna_key_expand_kt (key_words, kt);
  kalyna_key_expand_even (key_words, kt, rks);
  kalyna_key_expand_odd (rks);
}

DECLSPEC void kalyna_encrypt (PRIVATE_AS const u64 *rks,
                              PRIVATE_AS const u32 *in,
                              PRIVATE_AS u32 *out)
{
  u64 state[KALYNA_NB];
  for (int i = 0; i < KALYNA_NB; ++i)
  {
    state[i] = ((u64) in[i * 2]) | (((u64) in[i * 2 + 1]) << 32);
  }

  for (int i = 0; i < KALYNA_NB; ++i) state[i] += rks[i];

  for (int r = 1; r < KALYNA_NR; ++r)
  {
    kalyna_encipher_round (state);
    for (int i = 0; i < KALYNA_NB; ++i) state[i] ^= rks[r * KALYNA_NB + i];
  }
  kalyna_encipher_round (state);
  for (int i = 0; i < KALYNA_NB; ++i) state[i] += rks[KALYNA_NR * KALYNA_NB + i];

  for (int i = 0; i < KALYNA_NB; ++i)
  {
    out[i * 2]     = (u32) (state[i] >>  0);
    out[i * 2 + 1] = (u32) (state[i] >> 32);
  }
}
